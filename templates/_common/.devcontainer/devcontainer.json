{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "mise-devcontainer-${localWorkspaceFolderBasename}",
  "image": "",
  "containerUser": "root",
  "remoteUser": "dev",
  "privileged": true,
  "updateRemoteUserUID": true,
  "workspaceFolder": "/code/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/code/${localWorkspaceFolderBasename},type=bind",
  "mounts": ["source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"],
  "overrideCommand": false,
  "postCreateCommand": ["/usr/bin/fish", "-l", "-c", "/usr/local/bin/post-create.sh"],
  "postStartCommand": ["/usr/bin/fish", "-l", "-c", "/usr/local/bin/post-start.sh"],
  "postAttachCommand": ["/usr/bin/fish", "-l", "-c", "/usr/local/bin/post-start.sh"],
  "waitFor": "postStartCommand",
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "MISE_GITHUB_TOKEN": "${localEnv:MISE_GITHUB_TOKEN}"
  }
}
