{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "mise-devcontainer-${localWorkspaceFolderBasename}",
  "image": "",
  "containerUser": "root",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/code/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/code/${localWorkspaceFolderBasename},type=bind",
  "mounts": ["source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"],
  "runArgs": ["--privileged"],
  "overrideCommand": false,
  "postCreateCommand": ["post-create.sh"],
  "postStartCommand": ["post-start.sh"],
  "postAttachCommand": ["post-start.sh"],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "MISE_DEVCONTAINER": "1",
    "MISE_GITHUB_TOKEN": "${localEnv:MISE_GITHUB_TOKEN}"
  }
}
